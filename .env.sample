# Discord Bot Configuration
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
DISCORD_APP_ID=<YOUR_APP_ID>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>

# Supabase Configuration
# SECURITY: Use anon key ONLY (starts with eyJ...), never service key
SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
SUPABASE_KEY=<YOUR_SUPABASE_ANON_KEY>

# Admin Configuration (Optional)
# If not set, only server owner will have admin permissions
ADMIN_ROLE_ID=<YOUR_ADMIN_ROLE_ID>

# Event Channel Configuration (Optional)
# If set, event channels will be created under this category
# If not set, event channels will be created without a category (at root level)
EVENT_CATEGORY_ID=<YOUR_EVENT_CATEGORY_ID>
